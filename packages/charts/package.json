{
  "name": "@vizora/charts",
  "version": "0.1.0",
  "description": "Beautiful, production-ready charts built on the Vizora kernel.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-dom": ">=18.2.0",
    "d3-shape": "^3.2.0"
  },
  "dependencies": {
    "@vizora/core": "workspace:*",
    "@vizora/utils": "workspace:*"
  },
  "devDependencies": {
    "@types/d3-shape": "^3.1.6",
    "@types/react": "^19.0.0",
    "d3-shape": "^3.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
