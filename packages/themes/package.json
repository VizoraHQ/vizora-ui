{
  "name": "@vizora/themes",
  "version": "0.1.0",
  "description": "Themes, design tokens, and Tailwind preset for Vizora.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["./dist/*.css"],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./dark.css": "./dist/dark.css",
    "./light.css": "./dist/light.css",
    "./midnight.css": "./dist/midnight.css",
    "./base.css": "./dist/base.css"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup && pnpm run build:css",
    "build:css": "mkdir -p dist && cp src/styles/*.css dist/",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist .turbo"
  },
  "devDependencies": {
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
